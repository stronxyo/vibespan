# Build output. The installer compiles into %TEMP%, but spikes and tests build in place.
*.exe
*.dll
*.pdb
bin/
obj/

# Signing material - must never be committed
*.cer
*.pfx
*.snk

# Spike run artefacts (the .cs files are the deliverable, the reports are regenerated)
spikes/report*.txt

# Never commit credentials, under any name.
*.credentials.json

# NOTE: no rules for settings.json / log.txt / tokens.json / feed.json here. Those are
# runtime files and they live in %LOCALAPPDATA%\Vibespan, never in the repository - a
# blanket rule for them only hides legitimate files, which is exactly what happened to
# tests/fixtures/feed.json.
